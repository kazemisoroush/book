# Full Example

## Example Input
```json
{
  "metadata": {
    "title": "Pride and Prejudice",
    "author": "Austen, Jane, 1775-1817"
  },
  "chapters": [
    {
      "id": 1,
      "sections": [
        {
          "id": 1,
          "text": "Pride and Prejudice, by Austen, Jane, 1775-1817.",
          "type": "book_title_announcement"
        },
        {
          "id": 2,
          "text": "Chapter 1. Chapter I..",
          "type": "chapter_announcement"
        },
        {
          "id": 3,
          "text": "IT is a truth universally acknowledged, that a single man in possession of a good fortune must be in want of a wife",
          "type": "text"
        },
        {
          "id": 4,
          "text": "“My dear Mr. Bennet,” said his lady to him one day, “have you heard that Netherfield Park is let at last?{2}”",
          "type": "text",
        }
      ]
    }
  ],
  "characters": []
}
```

## Example Output
```json
{
  "chapters": [
    {
      "id": 1,
      "beats": [
        {
          "id": 1,
          "type": "book_title_announcement",
          "text": "Pride and Prejudice, by Jane Austen.",
          "character_id": 1,
          "emotion": "neutral"
        },
        {
          "id": 2,
          "type": "chapter_announcement",
          "text": "Chapter One.",
          "character_id": 1,
          "emotion": "neutral"
        },
        {
          "id": 3,
          "type": "narration",
          "text": "It is a truth universally acknowledged, that a single man in possession of a good fortune must be in want of a wife.",
          "character_id": 1,
          "emotion": "neutral"
        },
        {
          "id": 4,
          "text": "My dear Mr. Bennet.",
          "type": "dialogue",
          "character_id": 2,
          "emotion": "warmly insistent"
        },
        {
          "id": 5,
          "text": "Said his lady to him one day.",
          "type": "narration",
          "character_id": 1,
          "emotion": "neutral"
        },
        {
          "id": 6,
          "text": "Have you heard that Netherfield Park is let at last?",
          "type": "dialogue",
          "character_id": 2,
          "emotion": "eager excitement"
        }
      ]
    }
  ],
  "characters": [
    {
      "id": 1,
      "name": "Narrator",
      "sex": "female",
      "age": "adult"
    },
    {
      "id": 2,
      "name": "Mrs. Bennet",
      "sex": "female",
      "age": "adult"
    }
  ]
}
```

