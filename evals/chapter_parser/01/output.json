{
  "chapters": [
    {
      "id": 1,
      "beats": [
        {
          "id": 1,
          "type": "book_title_announcement",
          "text": "Pride and Prejudice, by Jane Austen.",
          "emotion": "neutral",
          "char_id": 1,
          "sec_id": 1
        },
        {
          "id": 2,
          "type": "chapter_announcement",
          "text": "Chapter One.",
          "emotion": "neutral",
          "char_id": 1,
          "sec_id": 2
        },
        {
          "id": 3,
          "type": "narration",
          "text": "It is a truth universally acknowledged, that a single man in possession of a good fortune, must be in want of a wife.",
          "emotion": "neutral",
          "char_id": 1,
          "sec_id": 3
        },
        {
          "id": 4,
          "type": "narration",
          "text": "However little known the feelings or views of such a man may be on his first entering a neighbourhood, this truth is so well fixed in the minds of the surrounding families, that he is considered as the rightful property of some one or other of their daughters.",
          "emotion": "neutral",
          "char_id": 1,
          "sec_id": 4
        },
        {
          "id": 5,
          "type": "dialogue",
          "text": "My dear Mr. Bennet.",
          "emotion": "warmly insistent",
          "char_id": 2,
          "sec_id": 5
        },
        {
          "id": 6,
          "type": "narration",
          "text": "Said his lady to him one day.",
          "emotion": "neutral",
          "char_id": 1,
          "sec_id": 5
        },
        {
          "id": 7,
          "type": "dialogue",
          "text": "Have you heard that Netherfield Park is let at last?",
          "emotion": "eager excitement",
          "char_id": 2,
          "sec_id": 5
        },
        {
          "id": 8,
          "type": "narration",
          "text": "Mr. Bennet replied that he had not.",
          "emotion": "neutral",
          "char_id": 1,
          "sec_id": 6
        },
        {
          "id": 9,
          "type": "dialogue",
          "text": "But it is.",
          "emotion": "insistent",
          "char_id": 2,
          "sec_id": 7
        },
        {
          "id": 10,
          "type": "narration",
          "text": "Returned she.",
          "emotion": "neutral",
          "char_id": 1,
          "sec_id": 7
        },
        {
          "id": 11,
          "type": "dialogue",
          "text": "For Mrs. Long has just been here, and she told me all about it.",
          "emotion": "eager",
          "char_id": 2,
          "sec_id": 7
        },
        {
          "id": 12,
          "type": "narration",
          "text": "Mr. Bennet made no answer.",
          "emotion": "neutral",
          "char_id": 1,
          "sec_id": 8
        },
        {
          "id": 13,
          "type": "dialogue",
          "text": "Do not you want to know who has taken it?",
          "emotion": "impatient",
          "char_id": 2,
          "sec_id": 9
        },
        {
          "id": 14,
          "type": "narration",
          "text": "Cried his wife impatiently.",
          "emotion": "neutral",
          "char_id": 1,
          "sec_id": 9
        },
        {
          "id": 15,
          "type": "dialogue",
          "text": "You want to tell me, and I have no objection to hearing it.",
          "emotion": "dryly indifferent",
          "char_id": 3,
          "sec_id": 10
        }
      ]
    }
  ],
