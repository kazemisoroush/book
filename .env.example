# ── AI Provider Selection ─────────────────────────────────────
# Choose "bedrock" or "anthropic" (default)
AI_PROVIDER=anthropic

# ── AWS (Bedrock for AI parsing) ──────────────────────────────
AWS_REGION=us-east-1
AWS_BEDROCK_MODEL_ID=us.anthropic.claude-opus-4-7
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# ── Anthropic (direct API for AI parsing) ─────────────────────
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_ID=claude-opus-4-7

# ── TTS Provider ──────────────────────────────────────────────
# ElevenLabs
ELEVENLABS_API_KEY=

# Fish Audio
FISH_AUDIO_API_KEY=

# ── Music Provider ────────────────────────────────────────────
# Suno AI (music generation)
SUNO_API_KEY=
